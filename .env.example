# Copy to .env for local builds. Never commit .env.
# The site reads precomputed files, so these are only needed by `python -m src.cli build`.

# football-data.org free tier (10 requests/minute). Used for current UEFA results and UTC kickoffs.
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# The Odds API free tier. Optional. Used only to read kickoff times, not prices.
# https://the-odds-api.com/
ODDS_API_KEY=

# Set by Vercel when cron jobs are enabled. The /api/cron/refresh route checks it.
CRON_SECRET=
